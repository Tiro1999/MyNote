FROM node:20-bookworm-slim

# Packages needed for Electron native modules and cross-platform packaging
RUN apt-get update && apt-get install -y \
    git \
    ca-certificates \
    libx11-dev \
    libxkbfile-dev \
    libsecret-1-dev \
    fakeroot \
    rpm \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY application/package*.json ./
RUN npm ci --prefer-offline

COPY application/ ./

CMD ["npm", "run", "build"]
