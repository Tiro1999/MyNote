# ── Version pins — change here, takes effect everywhere ──────────────────────
ARG NODE_VERSION=26
ARG NPM_VERSION=11

FROM node:${NODE_VERSION}-bookworm-slim

# Re-declare so the value is available after FROM
ARG NPM_VERSION=11

# Pin npm to the declared version
RUN npm install -g npm@${NPM_VERSION}

# Packages needed for Electron native modules, packaging, and runtime validation
RUN apt-get update && apt-get install -y \
    git \
    ca-certificates \
    libx11-dev \
    libxkbfile-dev \
    libsecret-1-dev \
    libcups2 \
    libgtk-3-0 \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libxss1 \
    libxtst6 \
    libxkbcommon0 \
    libx11-xcb1 \
    libxshmfence1 \
    libgbm1 \
    libasound2 \
    fakeroot \
    rpm \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY application/package*.json ./
RUN npm ci --prefer-offline

COPY application/ ./

CMD ["npm", "run", "build"]
