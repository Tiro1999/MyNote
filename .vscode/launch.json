{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MyNote: Build",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build",
      "cwd": "${workspaceFolder}/application"
    },
    {
      "name": "MyNote: Run Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:container",
      "cwd": "${workspaceFolder}/application"
    },
    {
      "name": "MyNote: Build + Run Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:container",
      "cwd": "${workspaceFolder}/application",
      "preLaunchTask": "MyNote: Build"
    }
  ]
}
