{
  "name": "MyNote Dev",
  "build": { "dockerfile": "Dockerfile" },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "typescript.tsdk": "application/node_modules/typescript/lib"
      }
    }
  },
  "postCreateCommand": "cd application && npm ci",
  "postStartCommand": "sudo mkdir -p /run/dbus && (test -S /run/dbus/system_bus_socket || sudo dbus-daemon --system --fork --nopidfile)",
  "remoteUser": "node"
}
