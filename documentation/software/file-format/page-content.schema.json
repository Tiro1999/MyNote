{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mynote.app/schema/page-content.schema.json",
  "title": "MyNote Page Content",
  "description": "Canvas content of a single chapter note, page, or subpage \u2014 stored at '{folder}/page.json'. 'folder' is '{dataRoot}/{notebookId}/{sectionId}/page.json' for a chapter's own note, or '{dataRoot}/{notebookId}/{sectionId}/{...subpageIdChain}/page.json' for a page/subpage. Mirrors PageContent / AnyCanvasElement in application/src/renderer/src/types/index.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pageId", "elements"],
  "properties": {
    "pageId": {
      "type": "string",
      "minLength": 1,
      "description": "Id of the section (chapter note) or page/subpage this content belongs to. Matches the last id in the folder's path."
    },
    "elements": {
      "type": "array",
      "description": "Free-canvas elements, each absolutely positioned via x/y/width/height/zIndex.",
      "items": { "$ref": "#/$defs/canvasElement" }
    }
  },
  "$defs": {
    "canvasElement": {
      "oneOf": [
        { "$ref": "#/$defs/textBoxElement" },
        { "$ref": "#/$defs/imageElement" },
        { "$ref": "#/$defs/fileElement" }
      ]
    },
    "textBoxElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "x", "y", "width", "height", "zIndex", "content"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "textbox" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "zIndex": { "type": "number" },
        "content": {
          "$ref": "tiptap-document.schema.json",
          "description": "TipTap ProseMirror JSON document, see tiptap-document.schema.json."
        }
      }
    },
    "imageElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "x", "y", "width", "height", "zIndex", "assetPath", "alt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "image" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "zIndex": { "type": "number" },
        "assetPath": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to this page's own 'assets/' subfolder."
        },
        "alt": { "type": "string" }
      }
    },
    "fileElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "x", "y", "width", "height", "zIndex", "assetPath", "fileName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "file" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "zIndex": { "type": "number" },
        "assetPath": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to this page's own 'assets/' subfolder."
        },
        "fileName": { "type": "string", "minLength": 1 }
      }
    }
  }
}
